rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Apps catalog is readable by everyone, modifiable by authenticated admins
    match /apps/{appId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profiles can be read and updated by their owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Download logs can be written on download and read by authenticated users
    match /downloads/{downloadId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Workspace sync records
    match /workspace_sync/{syncId} {
      allow read, write: if request.auth != null;
    }
  }
}
